// Clock + Calendar — kitty theme palette (linear color space)
Container(
  style: (),
  padding: 40.0,
  layout: (
    direction: Row,
    spacing: 40.0,
    align_items: Stretch,
    justify_content: Center,
  ),
  children: [
    // Left: clock section
    Container(
      id: Some("clock_section"),
      flex: 1.0,
      layout: (
        direction: Column,
        spacing: 0.0,
        align_items: Center,
        justify_content: Center,
      ),
      children: [
        // Time (updated each frame)
        Label(
          text: "<b>00:00</b>",
          size: 96.0,
          color: (0.439, 0.807, 0.141, 1.0),
          text_align: Center,
          font: Some("FiraMono"),
        ),
      ],
    ),

    // Vertical divider
    Container(
      width: Some(1.0),
      style: (
        background: Some((0.019, 0.019, 0.019, 1.0)),
      ),
    ),

    // Right: calendar section
    Container(
      id: Some("calendar_section"),
      flex: 1.0,
      layout: (
        direction: Column,
        spacing: 0.0,
        align_items: Center,
        justify_content: Center,
      ),
      children: [
        // Month header row
        Container(
          layout: (
            direction: Row,
            spacing: 8.0,
            align_items: Center,
            justify_content: Center,
          ),
          children: [
            Button(
              text: "<",
              action: "prev_month",
              width: Some(28.0),
              height: Some(24.0),
              font: Some("FiraMono"),
              style: (
                idle: (
                  border: Some((
                    width: 1.0,
                    color: (0.342, 0.342, 0.342, 1.0),
                  )),
                  corner_radii: (4.0, 4.0, 4.0, 4.0),
                ),
                hover: (
                  border: Some((
                    width: 1.0,
                    color: (0.523, 0.523, 0.523, 1.0),
                  )),
                  corner_radii: (4.0, 4.0, 4.0, 4.0),
                ),
                active: (
                  border: Some((
                    width: 1.0,
                    color: (0.342, 0.342, 0.342, 1.0),
                  )),
                  corner_radii: (4.0, 4.0, 4.0, 4.0),
                ),
                text_color: (0.982, 0.973, 0.973, 1.0),
              ),
            ),
            Label(
              text: "February 2026",
              size: 16.0,
              color: (0.982, 0.973, 0.973, 1.0),
              text_align: Center,
              width: 160.0,
              font: Some("FiraMono"),
            ),
            Button(
              text: ">",
              action: "next_month",
              width: Some(28.0),
              height: Some(24.0),
              font: Some("FiraMono"),
              style: (
                idle: (
                  border: Some((
                    width: 1.0,
                    color: (0.342, 0.342, 0.342, 1.0),
                  )),
                  corner_radii: (4.0, 4.0, 4.0, 4.0),
                ),
                hover: (
                  border: Some((
                    width: 1.0,
                    color: (0.523, 0.523, 0.523, 1.0),
                  )),
                  corner_radii: (4.0, 4.0, 4.0, 4.0),
                ),
                active: (
                  border: Some((
                    width: 1.0,
                    color: (0.342, 0.342, 0.342, 1.0),
                  )),
                  corner_radii: (4.0, 4.0, 4.0, 4.0),
                ),
                text_color: (0.982, 0.973, 0.973, 1.0),
              ),
            ),
          ],
        ),
        Spacer(size: 6.0),
        // Calendar grid (populated dynamically)
        Container(
          id: Some("calendar_grid"),
          layout: (
            direction: Grid(columns: 7),
            spacing: 2.0,
            align_items: Center,
          ),
          children: [],
        ),
      ],
    ),
  ],
)
